diff --git a/common/al_env.sh.in b/common/al_env.sh.in
index 1d363128..9fea742b 100644
--- a/common/al_env.sh.in
+++ b/common/al_env.sh.in
@@ -17,5 +17,5 @@ if [ -d "${CMAKE_INSTALL_PREFIX}/models/mdsplus" ]; then
 fi
 if [ -f "${CMAKE_INSTALL_PREFIX}/include/IDSDef.xml" ]; then
     export IDSDEF_PATH="${CMAKE_INSTALL_PREFIX}/include/IDSDef.xml"
-    export IMAS_VERSION="$( grep -Pom 1 '(?<=<version>)[^<]*' $IDSDEF_PATH )"
+    export IMAS_VERSION="$(sed -n 's:.*<version>\([^<]*\)</version>.*:\1:p' "$IDSDEF_PATH" | head -n 1)"
 fi
